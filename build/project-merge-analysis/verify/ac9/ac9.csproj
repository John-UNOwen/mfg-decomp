<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Assembly-CSharp verification at Unity 2022.3 default C# 9: the transformed project copy
    Assets/Assembly-CSharp plus the six merged plugin trees, plus the just-built firstpass
    assembly (Unity auto-references Assembly-CSharp-firstpass into Assembly-CSharp).
    The loose middleware dlls in build/reftype stand in for the Packages + Plugins assemblies
    the editor will reference (identical assembly names and identities).
    See docs/21-project-merge.md.
  -->

  <Import Project="..\..\..\asmdef-probe\Directory.Build.props" />

  <PropertyGroup>
    <AssemblyName>Assembly-CSharp</AssemblyName>
    <RootNamespace>AssemblyCSharpVerify</RootNamespace>
    <LangVersion>9</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\unity-project\Assets\Assembly-CSharp\**\*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\unity-project\Assets\kamunity\**\*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\unity-project\Assets\Shirahama\**\*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\unity-project\Assets\Shirahama.Async\**\*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\unity-project\Assets\Shirahama.Rx\**\*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\unity-project\Assets\VirtualSurround\**\*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\unity-project\Assets\Win10actLog-Runtime\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(MSBuildThisFileDirectory)..\firstpass9\bin\Debug\net472\Assembly-CSharp-firstpass.dll" />
  </ItemGroup>

</Project>
