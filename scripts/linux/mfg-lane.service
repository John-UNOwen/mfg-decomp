; mfg-lane.service - the RyuNET core under systemd.
; Template: install_systemd.sh substitutes the at-sign placeholder tokens and stages the result.
; Modelled on scripts/hosting_up.ps1:53-54 (node AsphyxiaCore.js, working directory
; <core>/dist, presenter secret exported) and lane_up.sh section 8.

[Unit]
Description=MFG lane core (node AsphyxiaCore.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@CORE_DIR@/dist
; WorkingDirectory must be <core>/dist: EXEC_PATH (plugins, savedata) is derived from
; process.cwd() (dist/utils/EamuseIO.js:96-99), uploads is cwd/uploads
; (dist/AsphyxiaCore.js:74), log.txt is created in cwd (dist/utils/Logger.js:37), and
; ASSETS_PATH is the cwd-relative "../build-env/assets" (dist/utils/EamuseIO.js:98)
; feeding views (dist/AsphyxiaCore.js:67) and /static (:73). hosting_up.ps1:53 used
; the same working directory.
EnvironmentFile=@ENV_FILE@
EnvironmentFile=-@SEC_DIR@/core.env
; core.env carries VFG_PRESENTER_SECRET (chmod 600, owner @USER@); hosting_up.ps1:19-21
; read that secret from ~/.mfg-web and exported it to the core only. The '-' prefix
; keeps the unit startable before the operator creates the file.
ExecStart=@NODE_BIN@ AsphyxiaCore.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=@CORE_DIR@/dist
; dist itself is written: SaveConfig() rewrites config.ini on exit
; (dist/AsphyxiaCore.js:60; hosting_up.ps1:41-45 patches the same file while the core
; is stopped) and winston appends log.txt in cwd (dist/utils/Logger.js:37)
ReadWritePaths=@CORE_DIR@/dist/savedata
; SAVE_PATH = resolve(cwd, "savedata") (dist/utils/EamuseIO.js:99; the -d option
; default is "savedata", dist/utils/ArgConfig.js:60-63) - core.db plus every plugin
; SQLite store and their -wal sidecars live here
ReadWritePaths=@CORE_DIR@/dist/uploads
; UPLOADS_PATH = cwd/uploads, served at /uploads (dist/AsphyxiaCore.js:74-75);
; profile/banner uploads are written there
ReadWritePaths=@CORE_DIR@/dist/plugins
; dist/plugins/<name>/*.ts are loaded through ts-node
; (dist/eamuse/ExternalPluginLoader.js:59-74); plugin attribution compares literal
; stack-frame prefixes against the cwd-derived PLUGIN_PATH
; (dist/utils/EamuseIO.js:97, dist/eamuse/ExternalPluginLoader.js:36), so this exact
; path spelling must be the real one - do not symlink or bind-mount it from elsewhere
ReadWritePaths=@CORE_DIR@/build-env/assets
; ASSETS_PATH = cwd-relative "../build-env/assets" (dist/utils/EamuseIO.js:98): the
; webui renders views and static files from it. Writable because the deployment
; contract keeps asset-adjacent writes (jackets/banners family) inside the assets
; tree; I did not find a write site inside assets/ in this checkout - drop this line
; if your box never writes there
; Note: dist is not self-contained - dist/plugins/mfg@asphyxia/index.ts:369-370 falls
; back to require('../../src/aog/AogRegistry') / require('../../../src/aog/AogRegistry'),
; so @CORE_DIR@/src must travel with dist (read-only access is enough).

[Install]
WantedBy=multi-user.target
